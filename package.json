{
  "name": "@music-assistant/shared-icons",
  "version": "0.1.0",
  "description": "The shared Music Assistant icon set: one canonical set of player, device and area icons used by every Music Assistant client.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/music-assistant/shared-icons.git"
  },
  "files": [
    "icons",
    "manifest.json",
    "schema"
  ],
  "exports": {
    "./manifest.json": "./manifest.json",
    "./icons/*.svg": "./icons/*.svg"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "docs": "node scripts/generate-docs.mjs"
  }
}
